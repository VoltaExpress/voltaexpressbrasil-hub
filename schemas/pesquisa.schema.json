{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Pesquisa agregada e anonimizada",
  "type": "object",
  "properties": {
    "gerado_em": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "metodologia": {
      "type": "object",
      "properties": {
        "fonte": {
          "type": "string",
          "minLength": 1
        },
        "anonimizacao": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "limitacoes": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "fonte",
        "anonimizacao",
        "limitacoes"
      ],
      "additionalProperties": true
    },
    "grupos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "respostas": {
            "type": "integer",
            "minimum": 10
          },
          "perguntas": {
            "type": "array",
            "items": {
              "type": "object",
              "properties": {
                "id": {
                  "type": "string",
                  "minLength": 1
                },
                "titulo": {
                  "type": "string",
                  "minLength": 1
                },
                "dados": {
                  "type": "array",
                  "items": {
                    "type": "object",
                    "properties": {
                      "rotulo": {
                        "type": "string",
                        "minLength": 1
                      },
                      "valor": {
                        "type": "integer",
                        "minimum": 1
                      }
                    },
                    "required": [
                      "rotulo",
                      "valor"
                    ],
                    "additionalProperties": true
                  }
                }
              },
              "required": [
                "id",
                "titulo",
                "dados"
              ],
              "additionalProperties": true
            }
          }
        },
        "required": [
          "id",
          "titulo",
          "respostas",
          "perguntas"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "gerado_em",
    "metodologia",
    "grupos"
  ],
  "additionalProperties": true
}
