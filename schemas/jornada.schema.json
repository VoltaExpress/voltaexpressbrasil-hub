{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "Jornada (git + marcos)",
  "type": "object",
  "properties": {
    "gerado_em": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "fonte": {
      "type": "string",
      "minLength": 1
    },
    "meses": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^\\d{4}-\\d{2}$"
      }
    },
    "projetos": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "nome": {
            "type": "string",
            "minLength": 1
          },
          "commits": {
            "type": "integer",
            "minimum": 0
          },
          "por_mes": {
            "type": "object",
            "additionalProperties": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "required": [
          "nome",
          "commits",
          "por_mes"
        ],
        "additionalProperties": true
      }
    },
    "total_commits": {
      "type": "integer",
      "minimum": 0
    },
    "marcos": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "data": {
            "type": "string",
            "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
          },
          "projeto": {
            "type": "string",
            "minLength": 1
          },
          "titulo": {
            "type": "string",
            "minLength": 1
          },
          "descricao": {
            "type": "string",
            "minLength": 1
          },
          "fonte": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "data",
          "projeto",
          "titulo",
          "descricao",
          "fonte"
        ],
        "additionalProperties": true
      }
    }
  },
  "required": [
    "gerado_em",
    "fonte",
    "meses",
    "projetos",
    "total_commits",
    "marcos"
  ],
  "additionalProperties": true
}
